---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.tsx';
import ScrollFX from '../components/ScrollFX.tsx';
import Manifesto from '../components/Manifesto.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Portfolio from '../components/Portfolio.astro';
import Stack from '../components/Stack.astro';
import Contact from '../components/Contact.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const serviceColors: Record<string, string> = {
  desarrollo: 'text-lima',
  mantenimiento: 'text-patagonia',
  servicios: 'text-bone',
};
---
<Base
  title="TallerZur — Desarrollo web para pymes de Aysén | Puerto Cisnes"
  description="Desarrollo web, mantenimiento y servicios digitales para pymes, hostales y restaurantes de la Región de Aysén. Hecho en Puerto Cisnes, Patagonia chilena."
>
  <Nav />
  <Hero client:load />
  <ScrollFX client:idle />

  <!-- Manifesto: quiénes somos -->
  <Manifesto />

  <!-- Services: las 3 líneas de trabajo -->
  <Services />

  <!-- Process: cómo trabajamos -->
  <Process />

  <!-- Portfolio: proyectos en producción -->
  <Portfolio />

  <!-- Stack ticker -->
  <Stack />

  <!-- Blog preview -->
  <section class="px-5 md:px-10 lg:px-16 py-24 md:py-32">
    <div data-line class="h-px bg-gradient-to-r from-lima/50 via-patagonia/40 to-transparent mb-14"></div>
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
      <div>
        <p data-reveal class="font-mono text-lima text-xs tracking-widest uppercase">// blog</p>
        <h2 data-words class="mt-3 font-display text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.05]">Guías para tu negocio digital</h2>
      </div>
      <a data-reveal href="/blog" class="font-mono text-sm text-lima hover:underline flex-shrink-0">ver todos →</a>
    </div>

    <div data-stagger class="grid gap-4 md:gap-5 md:grid-cols-3">
      {posts.map((p) => (
        <a href={`/blog/${p.slug}/`} class="spotlight glass glass-hover group flex flex-col overflow-hidden rounded-4xl">
          {p.data.image ? (
            <div class="h-44 overflow-hidden">
              <img
                src={p.data.image}
                alt={p.data.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
          ) : (
            <div class="h-44 bg-gradient-to-br from-patagonia/30 to-forest flex items-center justify-center">
              <span class="font-mono text-lima/40 text-3xl">~/{p.data.service}</span>
            </div>
          )}
          <div class="relative p-6 flex flex-col flex-1">
            <span class={`font-mono text-xs ${serviceColors[p.data.service] ?? 'text-lima'}`}>~/{p.data.service}</span>
            <h3 class="mt-2 font-display text-lg font-bold group-hover:text-lima transition leading-snug flex-1">{p.data.title}</h3>
            <p class="mt-2 text-sm text-moss line-clamp-2">{p.data.description}</p>
            <span class="mt-4 font-mono text-xs text-lima inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Leer <span>→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Contact -->
  <Contact />
</Base>
