---
// Capturas reales y auto-actualizadas de cada sitio en producción (thum.io, sin API key).
const shot = (url: string) =>
  `https://s.wordpress.com/mshots/v1/${encodeURIComponent(url)}?w=1200&h=900`;

const projects = [
  {
    url: 'https://www.nutme.cl',
    name: 'nutme.cl',
    desc: 'Plataforma de nutrición online. Diseño, desarrollo y mantenimiento continuo.',
    tags: ['React', 'Node.js', 'Diseño UX'],
    img: shot('https://www.nutme.cl'),
    year: '2024',
  },
  {
    url: 'https://www.subelab.com',
    name: 'subelab.com',
    desc: 'Laboratorio digital — desarrollo, consultoría y servicios web para empresas.',
    tags: ['WordPress', 'Tailwind', 'SEO'],
    img: shot('https://www.subelab.com'),
    year: '2025',
  },
  {
    url: 'https://www.hostalmonchito.cl',
    name: 'hostalmonchito.cl',
    desc: 'Sitio para hostal en la Patagonia: presentación, contacto directo y reservas.',
    tags: ['Astro', 'Reservas', 'SEO local'],
    img: shot('https://www.hostalmonchito.cl'),
    year: '2025',
  },
];
---
<section id="portafolio" class="px-5 md:px-10 lg:px-16 py-24 md:py-32">
  <div data-line class="h-px bg-gradient-to-r from-lima/50 via-patagonia/40 to-transparent mb-14"></div>
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
    <div>
      <p data-reveal class="font-mono text-lima text-xs tracking-widest uppercase">// proyectos en producción</p>
      <h2 data-words class="mt-3 font-display text-4xl md:text-5xl lg:text-6xl font-bold max-w-2xl leading-[1.05]">
        Trabajo real, funcionando hoy.
      </h2>
    </div>
  </div>

  <div data-stagger class="grid gap-4 md:gap-5 md:grid-cols-2">
    {projects.map((p) => (
      <a
        href={p.url}
        target="_blank"
        rel="noopener"
        class="spotlight glass glass-hover group relative overflow-hidden rounded-4xl flex flex-col"
      >
        <!-- Image (captura real; degradado de marca como respaldo mientras genera / si el sitio no responde) -->
        <div class="relative h-56 md:h-64 overflow-hidden bg-gradient-to-br from-patagonia/40 via-forest to-abyss">
          <span class="absolute inset-0 flex items-center justify-center font-mono text-lima/30 text-2xl select-none">{p.name}</span>
          <img
            src={p.img}
            alt={`Captura del proyecto ${p.name}`}
            class="relative w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105 opacity-60 group-hover:opacity-90"
            loading="lazy"
            onerror="this.style.display='none'"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-abyss via-abyss/40 to-transparent"></div>
          <!-- Live badge -->
          <div class="absolute top-4 right-4 flex items-center gap-1.5 bg-abyss/70 backdrop-blur-sm px-3 py-1.5 rounded-full border border-lima/20">
            <span class="relative flex h-1.5 w-1.5">
              <span class="absolute inline-flex h-full w-full rounded-full bg-lima/70 animate-ping"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-lima"></span>
            </span>
            <span class="font-mono text-xs text-lima">live</span>
          </div>
        </div>

        <!-- Content -->
        <div class="relative p-7 flex flex-col flex-1">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-display text-2xl font-bold group-hover:text-lima transition">{p.name}</h3>
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs text-moss">{p.year}</span>
              <span class="flex h-8 w-8 items-center justify-center rounded-full border border-moss/30 text-moss group-hover:border-lima group-hover:text-lima group-hover:rotate-45 transition-all duration-300">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </div>
          <p class="text-moss text-sm leading-relaxed">{p.desc}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {p.tags.map(tag => (
              <span class="font-mono text-xs text-bone/60 bg-white/[0.04] border border-white/10 px-3 py-1 rounded-full">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </a>
    ))}

    <!-- Tu proyecto aquí (CTA, completa la grilla 2×2) -->
    <a
      href="/#contacto"
      class="spotlight group relative overflow-hidden rounded-4xl border border-dashed border-moss/30 hover:border-lima/50 transition-colors flex flex-col justify-center gap-4 p-8 md:p-10 min-h-[18rem]"
    >
      <div>
        <p class="font-mono text-[11px] tracking-widest uppercase text-moss">// próximo proyecto</p>
        <h3 class="mt-2 font-display text-2xl md:text-3xl font-bold leading-tight">
          Tu negocio podría estar <span class="text-lima">aquí.</span>
        </h3>
        <p class="mt-3 text-moss text-sm max-w-md">Sumamos pocos proyectos a la vez para cuidar cada uno. Hablemos del tuyo.</p>
      </div>
      <span class="inline-flex items-center gap-2 font-mono text-sm text-lima group-hover:gap-3 transition-all">
        Postular mi negocio
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </a>
  </div>
</section>
