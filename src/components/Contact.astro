---
import ContactForm from './ContactForm.tsx';
---
<section id="contacto" class="px-5 md:px-10 lg:px-16 py-24 md:py-32 relative overflow-hidden">
  <!-- Background accent -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-forest/10 to-transparent pointer-events-none"></div>
  <div
    class="absolute -left-40 top-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full bg-lima/5 blur-[120px] pointer-events-none"
  ></div>

  <div class="relative z-10">
    <div data-line class="h-px bg-patagonia/50 mb-16"></div>
    <div class="grid lg:grid-cols-2 gap-16 items-start">

      <!-- Left: copy -->
      <div>
        <p data-reveal class="font-mono text-lima text-xs tracking-widest uppercase">// hablemos</p>
        <h2 data-reveal class="mt-3 font-display text-3xl md:text-5xl font-bold leading-tight">
          Tu negocio merece<br />
          <span class="text-lima">estar en internet.</span>
        </h2>
        <p data-reveal class="mt-6 text-moss text-lg leading-relaxed max-w-md">
          Sin formularios que nadie responde, sin esperar semanas. Respondemos desde Puerto Cisnes, generalmente el mismo día.
        </p>

        <div data-reveal class="mt-10 space-y-4">
          <a
            href="https://wa.me/56900000000?text=Hola%20TallerZur,%20quiero%20una%20página%20web"
            target="_blank" rel="noopener"
            class="glass glass-hover flex items-center gap-4 p-4 rounded-2xl group"
          >
            <span class="w-11 h-11 rounded-xl bg-lima/10 border border-lima/25 text-lima flex items-center justify-center flex-shrink-0 group-hover:bg-lima group-hover:text-abyss transition-colors">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 21l1.7-4.3A8 8 0 1 1 12 20a8.4 8.4 0 0 1-4-1L3 21Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.5 9c0 3 2.5 5.5 5.5 5.5l1-1.4-1.8-1-1 .8c-.8-.4-1.7-1.3-2.1-2.1l.8-1-1-1.8L8.5 9Z" fill="currentColor"/></svg>
            </span>
            <div>
              <p class="font-display font-bold text-bone group-hover:text-lima transition text-sm">WhatsApp directo</p>
              <p class="font-mono text-xs text-moss">Respuesta en minutos</p>
            </div>
          </a>
          <a
            href="mailto:hola@tallerzur.cl"
            class="glass glass-hover flex items-center gap-4 p-4 rounded-2xl group"
          >
            <span class="w-11 h-11 rounded-xl bg-lima/10 border border-lima/25 text-lima flex items-center justify-center flex-shrink-0 group-hover:bg-lima group-hover:text-abyss transition-colors">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2.5" stroke="currentColor" stroke-width="1.8"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div>
              <p class="font-display font-bold text-bone group-hover:text-lima transition text-sm">hola@tallerzur.cl</p>
              <p class="font-mono text-xs text-moss">Respuesta en menos de 24h</p>
            </div>
          </a>
        </div>

        <div data-reveal class="mt-10 glass rounded-2xl p-5">
          <p class="font-mono text-xs text-moss uppercase tracking-widest mb-2 flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="text-lima"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.8"/></svg>
            Puerto Cisnes, Aysén — Chile
          </p>
          <p class="text-bone/70 text-sm leading-relaxed">
            Trabajamos con negocios de toda la Región de Aysén y del país. La distancia no es un problema.
          </p>
        </div>
      </div>

      <!-- Right: form -->
      <div data-reveal class="glass rounded-4xl p-7 md:p-10">
        <ContactForm client:load />
      </div>

    </div>
  </div>
</section>

<footer class="px-5 md:px-10 lg:px-16 py-10 border-t border-moss/10">
  <div class="flex flex-col md:flex-row justify-between gap-4 text-sm text-moss font-mono">
    <span>TallerZur — Puerto Cisnes, Aysén, Chile</span>
    <div class="flex gap-6">
      <a href="/#servicios" class="hover:text-lima transition">servicios</a>
      <a href="/#proceso" class="hover:text-lima transition">proceso</a>
      <a href="/blog" class="hover:text-lima transition">blog</a>
    </div>
    <span>~ hecho en la Patagonia ~</span>
  </div>
</footer>
