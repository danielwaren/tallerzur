---
// Widget de clima en vivo de Puerto Cisnes (Open-Meteo, sin API key).
interface Props {
  variant?: 'full' | 'compact';
}
const { variant = 'full' } = Astro.props;
---
<div
  data-weather
  class={`group flex items-center gap-2 rounded-full border border-moss/25 bg-forest/30 backdrop-blur-md px-3 py-1.5 transition-colors hover:border-lima/40 ${variant === 'compact' ? '' : ''}`}
  title="Clima ahora en Puerto Cisnes, Aysén"
  aria-label="Clima actual en Puerto Cisnes"
>
  <span data-weather-icon class="text-lima/90 flex-shrink-0" aria-hidden="true">
    <!-- placeholder spinner -->
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="animate-spin">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity="0.3" stroke-width="2" />
      <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
  </span>
  <span class="flex items-baseline gap-1.5 leading-none">
    <span data-weather-temp class="font-mono text-sm text-bone tabular-nums">--°</span>
    {variant === 'full' && (
      <span class="font-mono text-[10px] uppercase tracking-widest text-moss hidden sm:inline">
        Pto. Cisnes
      </span>
    )}
  </span>
</div>

<script>
  type Icon = 'sun' | 'cloud-sun' | 'cloud' | 'fog' | 'rain' | 'snow' | 'storm';

  const ICONS: Record<Icon, string> = {
    sun: '<circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5 5l1.6 1.6M17.4 17.4 19 19M19 5l-1.6 1.6M6.6 17.4 5 19"/></g>',
    'cloud-sun': '<circle cx="8" cy="8" r="3" fill="currentColor"/><g stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M8 2.6v1.6M2.6 8h1.6M4.2 4.2l1.1 1.1M11.8 4.2l-1.1 1.1"/></g><path d="M17.5 19H8.2A3.7 3.7 0 0 1 8 11.6a5 5 0 0 1 9.4 1.6A3.3 3.3 0 0 1 17.5 19Z" fill="currentColor" fill-opacity="0.85"/>',
    cloud: '<path d="M17.5 18H7a4 4 0 0 1 .3-8 5.5 5.5 0 0 1 10.5 2A3.5 3.5 0 0 1 17.5 18Z" fill="currentColor"/>',
    fog: '<path d="M17 12H7a3.5 3.5 0 0 1 .3-7 5 5 0 0 1 9.3 1.8A3 3 0 0 1 17 12Z" fill="currentColor" fill-opacity="0.85"/><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 16h14M7 19.5h10"/></g>',
    rain: '<path d="M17.5 14H7a4 4 0 0 1 .3-8 5.5 5.5 0 0 1 10.5 2A3.5 3.5 0 0 1 17.5 14Z" fill="currentColor"/><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M8 17.5 7 20M12 17.5 11 20.5M16 17.5 15 20"/></g>',
    snow: '<path d="M17.5 13H7a4 4 0 0 1 .3-8 5.5 5.5 0 0 1 10.5 2A3.5 3.5 0 0 1 17.5 13Z" fill="currentColor"/><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M8 17v.01M12 18.5v.01M16 17v.01M10 20v.01M14 20v.01"/></g>',
    storm: '<path d="M17.5 13H7a4 4 0 0 1 .3-8 5.5 5.5 0 0 1 10.5 2A3.5 3.5 0 0 1 17.5 13Z" fill="currentColor"/><path d="m12 14-2.5 4H12l-1.5 3.5L15 17h-2.3L14 14Z" fill="currentColor"/>',
  };

  function describe(code: number): { icon: Icon; label: string } {
    if (code === 0) return { icon: 'sun', label: 'Despejado' };
    if (code <= 2) return { icon: 'cloud-sun', label: 'Algo nublado' };
    if (code === 3) return { icon: 'cloud', label: 'Nublado' };
    if (code <= 48) return { icon: 'fog', label: 'Niebla' };
    if (code <= 67) return { icon: 'rain', label: 'Lluvia' };
    if (code <= 77) return { icon: 'snow', label: 'Nieve' };
    if (code <= 82) return { icon: 'rain', label: 'Chubascos' };
    if (code <= 86) return { icon: 'snow', label: 'Nieve' };
    return { icon: 'storm', label: 'Tormenta' };
  }

  async function loadWeather() {
    const nodes = document.querySelectorAll<HTMLElement>('[data-weather]');
    if (!nodes.length) return;
    try {
      const res = await fetch(
        'https://api.open-meteo.com/v1/forecast?latitude=-44.7427&longitude=-72.6926&current=temperature_2m,weather_code&timezone=auto',
        { cache: 'no-store' }
      );
      const data = await res.json();
      const temp = Math.round(data?.current?.temperature_2m ?? 0);
      const code = data?.current?.weather_code ?? 3;
      const { icon, label } = describe(code);

      nodes.forEach((node) => {
        const iconEl = node.querySelector<HTMLElement>('[data-weather-icon]');
        const tempEl = node.querySelector<HTMLElement>('[data-weather-temp]');
        if (iconEl) {
          iconEl.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none">${ICONS[icon]}</svg>`;
        }
        if (tempEl) tempEl.textContent = `${temp}°`;
        node.setAttribute('title', `${label} · ${temp}° en Puerto Cisnes, Aysén`);
      });
    } catch {
      document.querySelectorAll<HTMLElement>('[data-weather-temp]').forEach((el) => {
        el.textContent = 'Aysén';
      });
    }
  }

  loadWeather();
  // refresh every 15 min
  setInterval(loadWeather, 15 * 60 * 1000);
</script>
